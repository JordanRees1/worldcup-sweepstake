# Copy this file to `server/.env` and fill in values for live mode.
# TIP: Use the root npm scripts to demo different tournament stages without touching this file:
#   npm run dev:group-stage   — matchday 1+2 done, matchday 3 to come
#   npm run dev:quarters      — group stage + R32 + R16 done, QF upcoming
#   npm run dev:final         — everything through SFs, Final tomorrow
# Generate scenario files first: npm run generate:scenarios
# `server/.env` is gitignored — never commit a real key.

PORT=8787

# seed = offline, derived from datasets/ (no key needed; this is the default)
# live = fetch live results from the football API
DATA_SOURCE=seed

# Football results API — only needed when DATA_SOURCE=live.
# Recommended provider: football-data.org (free tier).
FOOTBALL_API_PROVIDER=football-data
FOOTBALL_API_KEY=

# How long to cache API responses, in seconds.
RESULTS_CACHE_TTL_SECONDS=60
