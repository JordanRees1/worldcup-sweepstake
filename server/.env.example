# Copy this file to `server/.env` and fill in values for live mode.
# TIP: Use the root npm scripts to demo different tournament stages without touching this file:
#   npm run dev:group-stage   — matchday 1+2 done, matchday 3 to come
#   npm run dev:quarters      — group stage + R32 + R16 done, QF upcoming
#   npm run dev:final         — everything through SFs, Final tomorrow
# Generate scenario files first: npm run generate:scenarios
# `server/.env` is gitignored — never commit a real key.

PORT=8787

# seed = offline, derived from datasets/ (no key needed; this is the default)
# live = fetch live results from the football API
DATA_SOURCE=seed

# Football results API — only needed when DATA_SOURCE=live.
# Recommended provider: football-data.org (free tier).
FOOTBALL_API_PROVIDER=football-data
FOOTBALL_API_KEY=

# How long to cache API responses, in seconds. (Prod uses 30 for in-play scores.)
RESULTS_CACHE_TTL_SECONDS=60

# ── Multi-tenant gateway (self-service sweepstakes) ────────────────────────────
# Leave all three unset for plain local dev: creation is open and admin is disabled,
# and runtime tenants are stored in datasets/tenants/ (gitignored).

# Seeds the one-time "create password" gating POST /api/sweepstakes (the self-service /new flow).
# The live password is stored in the tenant store and ROTATES after each create (single-use, to stop
# code-sharing); the current value is shown on /a/admin. Unset = creation open. CLI bypasses the gate.
CREATE_TOKEN=

# Global admin token: edit/delete any sweepstake + open /a/admin. Unset = admin disabled.
ADMIN_TOKEN=

# Azure Blob storage account for the tenant store (prod). Set → Blob (authed by the
# container's managed identity / your `az login`); unset → local dir (datasets/tenants/).
AZURE_STORAGE_ACCOUNT=
