{
  "name": "sweepstake",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev -w @sweepstake/server",
    "dev:web": "npm run dev -w @sweepstake/web",
    "build": "npm run build -w @sweepstake/shared && npm run build -w @sweepstake/server && npm run build -w @sweepstake/web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests",
    "report:picks": "npm run report:picks -w @sweepstake/server",
    "report:picks:work": "cross-env SWEEPSTAKE=work npm run report:picks -w @sweepstake/server",
    "dev:work": "cross-env SWEEPSTAKE=work concurrently -k -n api,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "generate:scenarios": "tsx server/src/data/generateScenarios.ts",
    "dev:group-stage": "cross-env SEED_SCENARIO=group-stage concurrently -k -n api,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:quarters": "cross-env SEED_SCENARIO=quarterfinals concurrently -k -n api,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:final": "cross-env SEED_SCENARIO=final concurrently -k -n api,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:live-demo": "cross-env SEED_SCENARIO=live-demo concurrently -k -n api,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.8"
  }
}
